#!/usr/bin/env bash
# 병행 레인 하나를 메인에 합친다 (mc-logi-build-onboard 방출 · 시범).
#
#   scripts/lanes/lane-merge.sh <이름> [--with <그룹>]… [--check '<이름>|<통과줄 정규식 또는 ->|<명령>']…
#                                      [--push] [--keep] [--plan] [--worktree <경로> --branch <브랜치>]
#
#   --with <그룹>   아래 CHECKS 중 그 그룹의 검사를 더한다(그룹 always 는 늘 돈다 · 여러 번 줄 수 있다)
#   --check '…'     이번 합치기에만 검사 하나를 더한다(예: 바뀐 부분의 골라 낸 시험)
#   --push          검사가 모두 초록이면 메인 브랜치를 origin 에 푸시
#   --keep          합친 뒤에도 워크트리·브랜치·레인 기록을 지우지 않는다(작업자도 놓아주지 않는다)
#   --plan          아무것도 바꾸지 않고 할 일만 찍는다(인자 확인용 — 먼저 이것부터)
#   --worktree/--branch  레인 기록이 없는 레인의 워크트리·브랜치를 직접 준다
#                   (★ 레인만 받는다 — 워크트리는 `.claude/worktrees/lane-*` 아래이거나 레인 기록에 적힌 것,
#                      브랜치는 `lane/*` 이거나 그 기록의 브랜치. 사용자의 다른 작업 워크트리는 거절한다)
#
# ★ 메인 폴더에서 부른다 — 레인 폴더 안에서 부르면 정리 단계가 부른 셸의 작업 폴더를 지우게 되어 멈춘다.
# ★ Orca 작업자 레인은 작업자의 `worker_done` 을 확인한 뒤에 부른다 — rebase 가 작업자가 아직 쓰는 브랜치를 바꾼다.
#
# 레인 찾기(이름 규칙에 기대지 않는다): ① --worktree/--branch ② 레인 기록 <git-common-dir>/lane-state/<이름>
#   (lane-new.sh · lane-orca.sh 가 적는다) ③ 둘 다 없으면 옛 규칙 `.claude/worktrees/lane-<이름>` · `lane/<이름>`
#
# 순서: 레인 깨끗한지 → 레인 rebase(충돌이면 abort 하고 멈춘다 — ☠️ 손으로 합치지 않는다 · 레인을 재작업으로)
#       → 메인에 빨리감기(ff) 합치기 → 메인에서 검사 → (모두 초록 · --push) 푸시
#       → Orca 작업자 놓아주기 → 워크트리·브랜치 정리 → 레인 기록 지움
# ★ 검사가 빨가면 메인을 «되돌리지 않고» 합친 채 멈춘다 — 푸시·정리만 하지 않는다. 되돌릴지는 사람이 판단한다.
#   레인을 고쳐 커밋한 뒤 이 스크립트를 다시 부르면(rebase 는 빈 일이 된다) 검사 → 푸시 → 정리를 이어 간다.
# ★ 판정은 종료코드 + 통과줄 정규식이 있는 검사는 그 줄이 출력에 실제로 있어야 초록이다(빈 실행 = 초록 아님).
# ★ 무거운 시험(전체 시험 등)은 한 번에 한 레인만 — 여기 CHECKS 에 기본으로 넣지 않는다(온보딩 확정).
# ★ 정리 전에 레인 폴더를 작업 폴더로 쓰는 남은 프로세스(부하용 반복 · 감시 모드 시험 · 개발 서버)를 끝낸다.
#   실측: 작업자가 띄운 부하용 프로세스 10개가 레인을 지운 뒤에도 하루 가까이 돌았다. 판정은 프로세스 «이름»으로만 하고
#   (명령줄에는 비밀이 실릴 수 있어 읽지도 찍지도 않는다) 작업자 세션(claude·orca·codex·opencode)은 건드리지 않는다.
#   ☠️ 터미널이 붙은 프로세스와 셸·편집기(bash·zsh·vim·tmux 등)는 끝내지 않는다 — 사람이 그 폴더에서 일하는 중일 수 있다.
#   그런 것이 남아 있으면 정리를 멈춘다(7 · 닫고 다시 부른다 · LANE_KEEP_PROCS=1 이면 알리기만 하고 정리를 이어 간다).
# 🚫 출력에서 자격증명이 실린 URL·password=·token= 줄은 거른다.
#
# 종료코드: 0 끝 · 1 인자/상태 오류 · 3 rebase 충돌(또는 잠금이 아닌 rebase 실패) · 4 ff 실패 · 5 검사 빨강
#           · 6 푸시 실패 · 7 정리 실패 · 8 git 잠금(index.lock 등 — 잠시 뒤 다시)
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lanes/_common.sh
. "$HERE/_common.sh"

# 합치기 검사 — 한 줄에 "그룹|이름|통과줄 정규식(없으면 -)|명령". 명령은 메인 꼭대기에서 하위 셸로 돈다.
#   온보딩이 이 저장소의 빌드 파일에서 초안하고 인터뷰로 확정한 값이다(슬롯 lane_checks).
#   명령 안에서 `lane_changed_files <명령…>` 를 쓰면 이번에 합친 파일(지운 것 제외)만 그 명령에 넘긴다(서식 검사 등).
<!-- IF lane_checks -->
CHECKS=(
{{lane_checks}}
)
<!-- ELSE -->
CHECKS=()   # 온보딩 인터뷰에서 「합치기 검사 없음」으로 확정 — ☠️ 검사 없는 합치기는 레인 QA 만 믿는다
<!-- ENDIF lane_checks -->

usage() { sed -n '3,13p' "$0" >&2; exit 1; }
[ $# -ge 1 ] || usage
NAME="$1"; shift
case "$NAME" in -*) usage ;; esac
lane_check_name "$NAME"

PUSH=0; KEEP=0; PLAN=0; WITH=(); EXTRA=(); OPT_WT=""; OPT_BR=""
while [ $# -gt 0 ]; do
  case "$1" in
    --with) [ $# -ge 2 ] || lane_die "--with 뒤에 그룹"; WITH+=("$2"); shift 2 ;;
    --check) [ $# -ge 2 ] || lane_die "--check 뒤에 '이름|정규식|명령'"
      case "$2" in *'|'*'|'*) ;; *) lane_die "--check 는 '이름|통과줄 정규식 또는 -|명령' 꼴: $2" ;; esac
      EXTRA+=("extra|$2"); shift 2 ;;
    --push) PUSH=1; shift ;;
    --keep) KEEP=1; shift ;;
    --plan) PLAN=1; shift ;;
    --worktree) [ $# -ge 2 ] || lane_die "--worktree 뒤에 경로"; OPT_WT="$2"; shift 2 ;;
    --branch) [ $# -ge 2 ] || lane_die "--branch 뒤에 브랜치"; OPT_BR="$2"; shift 2 ;;
    --help|-h) usage ;;
    *) lane_die "모르는 인자: $1" ;;
  esac
done

# 고른 검사(always + --with 그룹 + --check) — 모르는 그룹이면 멈춘다(오타로 검사가 조용히 빠지지 않게).
STEPS=()
for w in ${WITH[@]+"${WITH[@]}"}; do
  found=0
  for s in ${CHECKS[@]+"${CHECKS[@]}"}; do [ "${s%%|*}" = "$w" ] && found=1; done
  [ "$found" = 1 ] || lane_die "모르는 검사 그룹: $w (있는 그룹: $(for s in ${CHECKS[@]+"${CHECKS[@]}"}; do printf '%s\n' "${s%%|*}"; done | sort -u | tr '\n' ' '))"
done
for s in ${CHECKS[@]+"${CHECKS[@]}"}; do
  g="${s%%|*}"
  if [ "$g" = always ]; then STEPS+=("$s"); continue; fi
  for w in ${WITH[@]+"${WITH[@]}"}; do [ "$g" = "$w" ] && STEPS+=("$s"); done
done
STEPS+=(${EXTRA[@]+"${EXTRA[@]}"})

MAIN="$(lane_main_root)"
MAINBR="$(lane_main_branch "$MAIN")"
STATE="$(lane_state_file "$NAME")" || lane_die "레인 기록 자리를 못 구했다"
OWNER="$(lane_state_get "$STATE" owner)"; OWNER="${OWNER:-git}"
KIND="$(lane_state_get "$STATE" kind)"; KIND="${KIND:-impl}"
WT="$(lane_state_get "$STATE" worktree)"
BR="$(lane_state_get "$STATE" branch)"
SRC="기록 $STATE"
if [ -n "$OPT_WT$OPT_BR" ]; then
  [ -n "$OPT_WT" ] && [ -n "$OPT_BR" ] || lane_die "--worktree 와 --branch 는 함께 준다"
  WT="$OPT_WT"; BR="$OPT_BR"; SRC="인자"
  case "$WT" in /*) ;; *) if [ -d "$WT" ]; then WT="$(cd "$WT" && pwd -P)"; else WT="$MAIN/$WT"; fi ;; esac
elif [ -z "$WT" ] || [ -z "$BR" ]; then
  WT="$MAIN/$LANE_WT_DIR_REL/lane-$NAME"; BR="lane/$NAME"; SRC="이름 규칙(기록 없음)"
fi
[ ! -d "$WT" ] || WT="$(cd "$WT" && pwd -P)"
[ "$WT" != "$MAIN" ] || lane_die "레인 워크트리가 메인 저장소 자체다: $WT"
[ "$BR" != "$MAINBR" ] || lane_die "레인 브랜치가 메인 브랜치($MAINBR)다 — 지우면 안 되는 브랜치다"
# 지울 대상 확인 — 이 저장소의 워크트리 목록에 있는 폴더만 레인으로 받는다(아무 폴더나 지우지 않게).
WT_KNOWN=0; [ -d "$WT" ] && lane_is_worktree "$MAIN" "$WT" && WT_KNOWN=1
# ★ 그리고 «레인»만 받는다 — 등록된 워크트리라도 사용자의 다른 작업(기능 브랜치 워크트리)이면 rebase·합치기·삭제가
#   그 작업을 망친다(실측: 다른 이름으로 넘긴 기능 워크트리가 메인에 합쳐지고 지워졌다).
#   워크트리: 레인 자리(.claude/worktrees/lane-*) 아래이거나 어느 레인 기록에 적힌 경로 · 브랜치: lane/* 이거나 그 기록의 브랜치.
LANE_OK=0; LANE_WHY=""
REC_BR="$(lane_record_branch_for "$WT" || true)"
case "$WT/" in
  "$MAIN/$LANE_WT_DIR_REL"/lane-*/) LANE_OK=1 ;;
  *) [ -n "$REC_BR" ] && LANE_OK=1 || LANE_WHY="워크트리가 레인 자리($LANE_WT_DIR_REL/lane-*)도 아니고 레인 기록에도 없다" ;;
esac
if [ "$LANE_OK" = 1 ]; then
  case "$BR" in
    lane/*) ;;
    *) if [ -z "$REC_BR" ] || [ "$REC_BR" != "$BR" ]; then LANE_OK=0; LANE_WHY="브랜치 '$BR' 가 lane/* 도 아니고 레인 기록의 브랜치도 아니다"; fi ;;
  esac
fi
DISPATCHES="$( { lane_state_all "$STATE" dispatch; [ ! -f "$WT/.lane-dispatch" ] || cat "$WT/.lane-dispatch"; } \
  | sed -E 's/#.*//; s/^[[:space:]]+//' | awk 'NF { print $1 }' | sort -u)"

cleanup_desc() {
  if [ "$OWNER" = orca ]; then echo "orca worktree rm --worktree path:$WT (안 되면 git worktree remove) + branch -d $BR"
  else echo "git worktree remove + branch -d $BR"; fi
}

if [ "$PLAN" = 1 ]; then
  echo "계획 (아무것도 바꾸지 않음)"
  echo "  메인     : $MAIN ($MAINBR)"
  echo "  레인     : $WT ($BR) — $SRC · owner=$OWNER · kind=$KIND"
  [ "$WT_KNOWN" = 1 ] || echo "  ⚠️ 이 경로는 이 저장소의 워크트리 목록에 없다 — 실제 실행에서는 멈춘다"
  [ "$LANE_OK" = 1 ] || echo "  ⚠️ 레인이 아니다($LANE_WHY) — 실제 실행에서는 멈춘다"
  [ "$OWNER" != orca ] || echo "  ⚠️ Orca 작업자 레인 — 작업자의 worker_done 을 확인한 뒤에 실행한다(rebase 가 작업자 브랜치를 바꾼다)"
  echo "  rebase   : $BR ← $MAINBR · 충돌이면 abort 후 멈춤(3) · git 잠금이면 멈춤(8)"
  echo "  합치기   : git merge --ff-only $BR (메인에서)"
  [ ${#STEPS[@]} -gt 0 ] || echo "  검사     : 없음 ⚠️"
  for s in ${STEPS[@]+"${STEPS[@]}"}; do
    IFS='|' read -r g n r c <<<"$s"
    echo "  검사     : [$g/$n] $c$([ "$r" = - ] || echo "  ← 통과줄 /$r/ 필수")"
  done
  echo "  푸시     : $([ "$PUSH" = 1 ] && echo "git push origin $MAINBR" || echo '안 함')"
  if [ "$KEEP" = 1 ]; then
    echo "  정리     : 안 함(--keep) — Orca 작업자도 놓아주지 않는다"
  else
    if [ -n "$DISPATCHES" ]; then
      while IFS= read -r id; do [ -z "$id" ] || echo "  놓아주기 : orca orchestration worker-release --dispatch $id"; done <<<"$DISPATCHES"
    else echo "  놓아주기 : 없음(.lane-dispatch · 기록의 dispatch 없음)"; fi
    echo "  남은 것  : 레인 폴더를 작업 폴더로 쓰는 프로세스를 끝낸다(이름으로만 판정 · claude·orca 는 둔다 · LANE_KEEP_PROCS=1 이면 알리기만)"
    echo "  정리     : $(cleanup_desc) · 레인 기록 지움"
  fi
  exit 0
fi

[ -d "$WT" ] || lane_die "레인 워크트리가 없다: $WT"
[ "$WT_KNOWN" = 1 ] || lane_die "이 경로는 이 저장소의 워크트리가 아니다: $WT (git worktree list 로 확인 — 아무 폴더나 지우지 않는다)"
[ "$LANE_OK" = 1 ] || lane_die "레인이 아니다 — $LANE_WHY. 이 도구는 레인만 합치고 지운다(사용자의 다른 작업 워크트리는 손대지 않는다)"
if [ "$KEEP" = 0 ]; then
  case "$(pwd -P)/" in "$WT"/*) lane_die "레인 폴더 안에서 불렀다 — 정리가 이 셸의 작업 폴더를 지운다. 메인($MAIN)에서 다시 불러라" ;; esac
fi
git -C "$MAIN" show-ref --verify --quiet "refs/heads/$BR" || lane_die "레인 브랜치가 없다: $BR"
[ "$(git -C "$WT" rev-parse --abbrev-ref HEAD)" = "$BR" ] || lane_die "워크트리가 $BR 에 있지 않다"
DIRTY="$(git -C "$WT" status --porcelain)"
[ -z "$DIRTY" ] || { printf '%s\n' "$DIRTY" | sed 's/^/    /' >&2; lane_die "레인에 커밋 안 된 것이 있다 — 커밋하거나 치운 뒤 다시"; }

MAIN_MOD="$(git -C "$MAIN" status --porcelain --untracked-files=no)"
[ -z "$MAIN_MOD" ] || { echo "  ⚠️ 메인 작업 트리에 커밋 안 된 변경이 있다(검사 결과에 섞인다):"; printf '%s\n' "$MAIN_MOD" | sed 's/^/      /'; }

LOGDIR="$(mktemp -d "${TMPDIR:-/tmp}/lane-merge-$NAME.XXXXXX")"
BEFORE="$(git -C "$MAIN" rev-parse "$MAINBR")"
# 재실행(검사 빨강 뒤 레인을 고친 경우) — 이미 합쳐진 레인 커밋의 시작점을 기록에서 되찾는다(서식 대상 계산용).
PREV_BASE="$(lane_state_get "$STATE" merged_from)"
AHEAD="$(git -C "$MAIN" rev-list --count "$MAINBR..$BR")"

die_lock() {
  local log="$1" what="$2" p paths
  paths="$(lane_lock_paths "$log")"
  echo "    잠금 파일:" >&2
  if [ -z "$paths" ]; then
    echo "      (로그에 잠금 파일 경로가 없다 — $log 를 보라)" >&2
  else
    while read -r p; do
      echo "      $p $([ -e "$p" ] && echo '(지금도 있다)' || echo '(지금은 없다)')" >&2
    done <<<"$paths"
  fi
  LANE_DIE_RC=8 lane_die "$what — git 잠금이다(충돌 아님). 다른 git 이 도는 중이면 잠시 뒤 다시.
   git 프로세스가 없는데 잠금 파일이 계속 남아 있으면 그 파일을 사람이 지우고 다시(지우는 것은 이 도구가 하지 않는다)"
}

lane_say "rebase $BR ← $MAINBR (레인 커밋 $AHEAD)"
if ! lane_run 0 "$LOGDIR/rebase.log" git -C "$WT" rebase "$MAINBR"; then
  ABORTED=0
  if lane_rebase_in_progress "$WT"; then git -C "$WT" rebase --abort >/dev/null 2>&1 && ABORTED=1 || true; fi
  if lane_is_lock_failure "$LOGDIR/rebase.log"; then
    [ "$ABORTED" = 0 ] || echo "    (걸려 있던 rebase 는 abort 했다 — 레인은 원래대로)" >&2
    die_lock "$LOGDIR/rebase.log" "rebase 를 못 했다"
  fi
  lane_scrub <"$LOGDIR/rebase.log" | grep -E 'CONFLICT|error|fatal' | sed 's/^/    /' || true
  if grep -q 'CONFLICT' "$LOGDIR/rebase.log"; then
    LANE_DIE_RC=3 lane_die "rebase 충돌 — abort 했다(레인은 원래대로). 손으로 합치지 말고 그 레인을 재작업으로 돌려라"
  fi
  LANE_DIE_RC=3 lane_die "rebase 실패(충돌도 잠금도 아니다) — $([ "$ABORTED" = 1 ] && echo 'abort 했다' || echo '걸린 rebase 없음'). 로그 $LOGDIR/rebase.log"
fi

lane_say "빨리감기 합치기 $MAINBR ← $BR"
if ! lane_run 3 "$LOGDIR/merge.log" git -C "$MAIN" merge --ff-only "$BR"; then
  ! lane_is_lock_failure "$LOGDIR/merge.log" || die_lock "$LOGDIR/merge.log" "ff 합치기를 못 했다(메인은 그대로다)"
  LANE_DIE_RC=4 lane_die "ff 합치기 실패 — 메인은 그대로다(로그 $LOGDIR/merge.log)"
fi
AFTER="$(git -C "$MAIN" rev-parse "$MAINBR")"
echo "    $(git -C "$MAIN" rev-parse --short "$BEFORE") → $(git -C "$MAIN" rev-parse --short "$AFTER")"
# 이번 레인이 바꾼 범위의 시작점 — 재실행이면 첫 합치기 전 지점을 쓴다.
BASE="${PREV_BASE:-$BEFORE}"
[ -n "$PREV_BASE" ] || [ "$BEFORE" = "$AFTER" ] || { [ ! -f "$STATE" ] || lane_state_put "$STATE" merged_from "$BEFORE"; }
CHANGED_LIST="$LOGDIR/changed-files.lst"
git -C "$MAIN" diff -z --name-only --diff-filter=ACMR "$BASE" "$AFTER" >"$CHANGED_LIST"

# 검사 명령에서 쓰는 도우미 — 합친 파일(NUL 목록)을 명령 인자로 넘긴다. 없으면 건너뛴다.
lane_changed_files() {
  [ -s "$CHANGED_LIST" ] || { echo "대상 파일 없음"; return 0; }
  xargs -0 "$@" <"$CHANGED_LIST"
}

FAIL=()
i=0
for s in ${STEPS[@]+"${STEPS[@]}"}; do
  i=$((i + 1))
  IFS='|' read -r g n r c <<<"$s"
  log="$LOGDIR/step$i.log"
  lane_say "검사 [$g/$n]"
  if (cd "$MAIN" && lane_run 0 "$log" lane_eval "$c"); then rc=0; else rc=$?; fi
  if [ "$rc" -ne 0 ]; then
    lane_scrub <"$log" | tail -n 15 | sed 's/^/    | /'
    echo "    ❌ [$n] exit=$rc (로그 $log)"; FAIL+=("$n")
  elif [ "$r" != - ] && ! lane_scrub <"$log" | grep -qE "$r"; then
    echo "    ❌ [$n] exit=0 인데 통과줄 /$r/ 이 없다 — 검사가 안 돈 것이다 (로그 $log)"; FAIL+=("$n")
  else
    [ "$r" = - ] || lane_scrub <"$log" | grep -E "$r" | tail -n 2 | sed 's/^ */    /'
    echo "    ✅ [$n]"
  fi
done

if [ ${#FAIL[@]} -gt 0 ]; then
  cat >&2 <<EOF

❌ 메인 검사 빨강: ${FAIL[*]}
   메인은 이미 $(git -C "$MAIN" rev-parse --short "$AFTER") 로 합쳐져 있다 — 되돌리지 않았다 · 푸시·정리는 하지 않았다.
   이어 가기: 레인($WT)에서 고쳐 커밋한 뒤 같은 명령을 다시 부른다 — rebase 는 빈 일이 되고 검사부터 이어 간다.
   되돌릴지는 사람이 판단한다 — 합치기 전 지점: $(git -C "$MAIN" rev-parse --short "$BASE")
   (⚠️ reset --hard 는 메인 작업 트리의 커밋 안 된 변경까지 지운다)
   로그: $LOGDIR
EOF
  exit 5
fi

if [ "$PUSH" = 1 ]; then
  lane_say "푸시 origin $MAINBR"
  lane_run 3 "$LOGDIR/push.log" git -C "$MAIN" push origin "$MAINBR" \
    || LANE_DIE_RC=6 lane_die "푸시 실패 — 메인 로컬은 합쳐진 상태다(로그 $LOGDIR/push.log)"
fi

RELEASE_NOTE="없음"
if [ "$KEEP" = 0 ]; then
  # Orca 작업자 놓아주기 — 워크트리를 지우기 전에(지운 뒤엔 작업자 터미널이 사라진 폴더를 붙든다).
  if [ -n "$DISPATCHES" ]; then
    RELEASE_NOTE=""
    if CLI="$(lane_orca_cli)"; then
      while IFS= read -r id; do
        [ -n "$id" ] || continue
        lane_say "작업자 놓아주기 $id"
        if lane_run 2 "$LOGDIR/release-$id.log" "$CLI" orchestration worker-release --dispatch "$id" --json; then
          RELEASE_NOTE+="$id 놓음 · "
        else
          echo "    ⚠️ 놓아주기 실패(정리는 이어 간다) — 손으로: $CLI orchestration worker-release --dispatch $id" >&2
          RELEASE_NOTE+="$id ⚠️실패 · "
        fi
      done <<<"$DISPATCHES"
    else
      echo "    ⚠️ Orca 실행 파일 '$CLI' 를 못 찾아 작업자를 놓아주지 못했다 — 정리는 이어 간다: $DISPATCHES" >&2
      RELEASE_NOTE="⚠️ 못 함(orca 없음)"
    fi
    RELEASE_NOTE="${RELEASE_NOTE% · }"
  fi

  # ★ 더러운지부터 본다 — 프로세스를 끝낸 뒤에 「지우지 않는다」로 멈추면 남의 작업만 끊고 끝난다.
  [ -z "$(git -C "$WT" status --porcelain)" ] \
    || LANE_DIE_RC=7 lane_die "워크트리가 그새 더러워졌다 — 프로세스도 건드리지 않고 지우지 않았다: $WT"

  # 남은 프로세스 — 레인 폴더를 작업 폴더로 쓰는 것(부하용 반복 · 감시 모드 시험 · 개발 서버)을 끝낸다.
  # ★ 판정은 프로세스 이름(comm)과 터미널 유무로만 한다 — 명령줄 전체로 고르면 경로에 claude 가 든 레인(.claude/worktrees/…)의
  #   node·시험 프로세스까지 「작업자」로 보고 살려 둔다. 🚫 명령줄은 읽지도 찍지도 않는다(비밀이 실릴 수 있다).
  # ★ 끝내지 않고 알리기만: 작업자 세션(claude·orca·codex·opencode) · 터미널이 붙은 것 · 셸·편집기·멀티플렉서.
  # ★ 이 셸($$)과 부른 셸($PPID)은 대상에서 뺀다. -9 는 TERM 뒤에도 «같은 폴더에» 남은 터미널 없는 것에만, PID 를 다시 구해서.
  PROC_NOTE="없음"; HELD=0
  if LEFT="$(lane_pids_in_dir "$WT")"; then
    KILLED=0; KEPT=0; TERMED=""
    while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      [ "$pid" != "$$" ] && [ "$pid" != "$PPID" ] || continue
      comm="$(ps -o comm= -p "$pid" 2>/dev/null || true)"; comm="${comm##*/}"; [ -n "$comm" ] || continue
      lc="$(printf '%s' "$comm" | tr '[:upper:]' '[:lower:]')"; lc="${lc#-}"
      case "$lc" in *claude*|*orca*|*codex*|*opencode*) KEPT=$((KEPT + 1)); continue ;; esac
      tty="$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
      case "$lc" in sh|bash|zsh|fish|dash|ksh|login|vi|vim|nvim|emacs|nano|less|more|tmux|screen) human=1 ;; *) human=0 ;; esac
      case "$tty" in ""|"?"|"??") ;; *) human=1 ;; esac
      if [ "$human" = 1 ]; then
        echo "    ⚠️ 레인 폴더를 쓰는 대화형 프로세스 $pid ($comm${tty:+ · $tty}) — 끝내지 않는다(닫고 다시 불러라)" >&2
        KEPT=$((KEPT + 1)); HELD=$((HELD + 1)); continue
      fi
      if [ "${LANE_KEEP_PROCS:-0}" = 1 ]; then
        echo "    ⚠️ 남은 프로세스 $pid ($comm) — LANE_KEEP_PROCS=1 이라 둔다" >&2; KEPT=$((KEPT + 1))
      else
        echo "    ⚠️ 남은 프로세스를 끝낸다 $pid ($comm)" >&2
        kill "$pid" 2>/dev/null || true; KILLED=$((KILLED + 1)); TERMED="$TERMED $pid "
      fi
    done <<<"$LEFT"
    if [ "$KILLED" -gt 0 ]; then
      sleep 2
      # PID 는 재사용될 수 있다 — 지금 그 폴더를 쓰는 PID 를 다시 구해 TERM 을 보낸 것과 겹치는 것만, 터미널 없는 것만 -9.
      while IFS= read -r pid; do
        [ -n "$pid" ] || continue
        case "$TERMED" in *" $pid "*) ;; *) continue ;; esac
        tty="$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
        case "$tty" in ""|"?"|"??") kill -9 "$pid" 2>/dev/null || true ;; esac
      done < <(lane_pids_in_dir "$WT" || true)
    fi
    [ "$KILLED" -eq 0 ] && [ "$KEPT" -eq 0 ] || PROC_NOTE="끝냄 $KILLED · 둠 $KEPT"
  else
    PROC_NOTE="확인 못 함(lsof·/proc 없음)"
  fi
  if [ "$HELD" -gt 0 ] && [ "${LANE_KEEP_PROCS:-0}" != 1 ]; then
    LANE_DIE_RC=7 lane_die "레인 폴더를 쓰는 대화형 프로세스 $HELD 개가 남아 정리를 멈췄다 — 메인은 이미 합쳐져 있다. 그 셸·편집기를 닫고 같은 명령을 다시 부르면 검사부터 다시 돌고 정리를 이어 간다(LANE_KEEP_PROCS=1 이면 두고 정리)"
  fi

  lane_say "정리 $WT · $BR"
  REMOVED=0
  if [ "$OWNER" = orca ] && CLI="$(lane_orca_cli)"; then
    if lane_run 2 "$LOGDIR/wt-orca.log" "$CLI" worktree rm --worktree "path:$WT" --force --json; then REMOVED=1
    else echo "    ⚠️ orca worktree rm 실패 — git 으로 지운다(Orca 사이드바에 항목이 남을 수 있다)" >&2; fi
  fi
  if [ "$REMOVED" = 0 ] && [ -d "$WT" ]; then
    git -C "$MAIN" worktree remove "$WT" 2>"$LOGDIR/wt.log" \
      || git -C "$MAIN" worktree remove --force "$WT" || LANE_DIE_RC=7 lane_die "워크트리 정리 실패: $WT"
  fi
  git -C "$MAIN" worktree prune
  if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$BR"; then
    git -C "$MAIN" branch -d "$BR" >/dev/null || LANE_DIE_RC=7 lane_die "브랜치 정리 실패: $BR"
  fi
  rm -f "$STATE"
elif [ -f "$STATE" ]; then
  # --keep 으로 남긴 레인 — 이번 합치기는 끝났으니 「첫 합치기 지점」을 지운다(다음 합치기가 옛 지점을 쓰지 않게).
  grep -v '^merged_from=' "$STATE" >"$STATE.tmp" || true
  mv "$STATE.tmp" "$STATE"
fi

cat <<EOF

✅ 합치기 끝 — $NAME (kind=$KIND)
  메인   : $MAINBR $(git -C "$MAIN" rev-parse --short "$BASE") → $(git -C "$MAIN" rev-parse --short "$AFTER")
  검사   : ${#STEPS[@]}단계 초록
  푸시   : $([ "$PUSH" = 1 ] && echo 함 || echo '안 함')
  놓아줌 : $RELEASE_NOTE
  정리   : $([ "$KEEP" = 1 ] && echo '남김(--keep)' || echo "워크트리·브랜치·레인 기록 지움 (owner=$OWNER) · 남은 프로세스 ${PROC_NOTE:-없음}")
  다음   : MASTER 구현 칸은 메인이 갱신 · 화면 확인이 필요하면 지금 메인에서(레인 포트엔 로그인 세션이 없다)
EOF
