# 병행 레인 도구 공용 조각 — 다른 lane-*.sh 가 source 한다. 직접 실행하지 않는다.
# (mc-logi-build-onboard 가 {{project_name}} 에 방출 · 스위치 parallel_lanes · 시범)
#
# ★ 메인 저장소는 «지금 부른 자리»가 아니라 git 공용 디렉터리로 찾는다 — 워크트리 안에서 불러도
#   같은 메인을 가리킨다(공용 디렉터리의 core.worktree · 없으면 그 부모 — 서브모듈도 맞게 찾는다).
# 🚫 비밀값을 찍지 않는다 — 출력은 `lane_scrub` 를 거친다(자격증명이 실린 URL·password=·token= 줄을 거른다).
# 셸은 bash 다(macOS 기본 bash 3.2 에서도 돈다 — mapfile·연관 배열을 쓰지 않는다). git 2.31 이상(--path-format=absolute).
# 돌아가는 곳: macOS · 리눅스(프로세스 확인은 lsof 가 없으면 /proc 로 한다).

lane_die() { printf '❌ %s\n' "$*" >&2; exit "${LANE_DIE_RC:-1}"; }
lane_say() { printf '▶ %s\n' "$*"; }

# 메인 브랜치 기본값 — 온보딩이 확정한 값. LANE_MAIN_BRANCH 로 바꿀 수 있다.
LANE_MAIN_BRANCH_DEFAULT='{{lane_main_branch}}'
# 구현 레인 동시 상한 — 온보딩이 확정한 값. LANE_MAX 로 바꿀 수 있다(백필·기타 레인은 세지 않는다).
LANE_MAX_DEFAULT='{{lane_concurrency}}'
# 레인 워크트리 자리(git 길) — 메인 아래. ☠️ 이 폴더는 .gitignore 에 있어야 한다(없으면 메인 status 가 더러워진다).
LANE_WT_DIR_REL='.claude/worktrees'
# 변경지시서 폴더(저장소 기준 · 끝에 / 를 하나만 둔다 — git ls-tree 는 / 가 있어야 폴더 안을 본다)
LANE_CO_DIR='{{change_orders_path}}'
LANE_CO_DIR="${LANE_CO_DIR%/}/"

# git 버전 확인 — 2.31 미만이면 --path-format=absolute 가 「저장소 밖」처럼 실패해 엉뚱한 안내가 나온다(그래서 먼저 본다).
lane_require_git() {
  [ -z "${LANE_GIT_OK:-}" ] || return 0
  command -v git >/dev/null 2>&1 || lane_die "git 이 없다"
  local v maj min
  v="$(git --version 2>/dev/null | sed -nE 's/^git version ([0-9]+)\.([0-9]+).*/\1 \2/p')"
  read -r maj min <<<"${v:-0 0}"
  if [ "${maj:-0}" -gt 2 ] || { [ "${maj:-0}" -eq 2 ] && [ "${min:-0}" -ge 31 ]; }; then LANE_GIT_OK=1; return 0; fi
  lane_die "git 2.31 이상이 필요하다(지금: $(git --version 2>/dev/null || echo '?')) — 레인 도구는 --path-format=absolute 를 쓴다"
}

# git 공용 디렉터리(절대경로)
lane_git_common_dir() {
  lane_require_git
  git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || lane_die "git 저장소 안에서 실행하라"
}

# 메인 저장소 꼭대기(절대경로). 어느 워크트리에서 불러도 같은 값.
# ★ 「공용 디렉터리의 부모」만으로는 서브모듈에서 틀린다(공용 디렉터리가 상위 저장소의 .git/modules/<이름> 이다) —
#   그래서 core.worktree 가 있으면 그것을 따른다.
lane_main_root() {
  local common wt
  common="$(lane_git_common_dir)" || exit 1
  wt="$(git config --file "$common/config" core.worktree 2>/dev/null || true)"
  if [ -n "$wt" ]; then
    case "$wt" in /*) ;; *) wt="$common/$wt" ;; esac
    (cd "$wt" 2>/dev/null && pwd -P) || lane_die "core.worktree($wt)를 못 찾는다"
  elif [ "$(git config --file "$common/config" --bool core.bare 2>/dev/null || true)" = true ]; then
    lane_die "bare 저장소다 — 메인 작업 트리가 없어 레인 도구를 쓸 수 없다"
  else
    (cd "$common/.." && pwd -P)
  fi
}

# 이 경로가 메인 저장소의 워크트리 목록에 있나 — 지울 대상을 확인할 때 쓴다(아무 폴더나 지우지 않게).
lane_is_worktree() {
  local main="$1" want="$2" p
  while IFS= read -r p; do
    p="${p#worktree }"
    [ -d "$p" ] && p="$(cd "$p" && pwd -P)"
    [ "$p" = "$want" ] && return 0
  done < <(git -C "$main" worktree list --porcelain | grep '^worktree ')
  return 1
}

# 레인 이름 검사 — 브랜치·폴더·꼬리표에 그대로 들어가므로 좁게 받는다.
lane_check_name() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]] \
    || lane_die "레인 이름은 영소문자·숫자·하이픈 1~40자(첫 글자는 영숫자): '$1'"
}

# 레인 종류 검사 — impl(구현 · 동시 상한을 센다) · backfill(설계 반영) · other(조사·시안·기록 등)
lane_check_kind() {
  case "$1" in impl|backfill|other) ;; *) lane_die "레인 종류는 impl|backfill|other: '$1'" ;; esac
}

# 메인 브랜치 — 메인 저장소에 지금 체크아웃된 브랜치. 기대값과 다르면 멈춘다.
lane_main_branch() {
  local main="$1" br want="${LANE_MAIN_BRANCH:-$LANE_MAIN_BRANCH_DEFAULT}"
  br="$(git -C "$main" symbolic-ref --quiet --short HEAD || echo HEAD)"
  [ "$br" = "$want" ] \
    || lane_die "메인 저장소가 '$want' 가 아니라 '$br' 에 있다 — 메인 브랜치를 확인하라(LANE_MAIN_BRANCH 로 바꿀 수 있다)"
  printf '%s' "$br"
}

# 출력에서 비밀이 실렸을 법한 줄을 거른다 — 자격증명 URL(scheme://user:pass@host) · password= · passwd= · token= · api_key= · secret= ·
#   Authorization: · bearer · sk- 꼴 키. 실측: 시험 하네스 오류 문구가 DB 접속 주소를 비밀번호째 찍은 적이 있다.
#   넓게 거른다(줄을 잃는 쪽이 비밀을 찍는 쪽보다 낫다).
lane_scrub() { grep -v -i -E '[a-z][a-z0-9+.-]*://[^[:space:]]*:[^[:space:]]*@|password=|passwd=|token=|api[_-]?key=|secret=|authorization:|bearer |(^|[^a-z0-9])sk-[a-z0-9_-]{8,}' || true; }

# 명령을 돌려 종료코드를 «가리지 않고» 돌려준다. 출력은 파일에 받아 거른 꼬리만 보인다.
#   lane_run <꼬리줄수> <로그파일> <명령…>   → 명령의 종료코드를 그대로 반환
# ★ `cmd | tail` 은 파이프가 종료코드를 가린다(실측) — 그래서 파일로 받고 rc 를 따로 잡는다.
lane_run() {
  local n="$1" log="$2" rc; shift 2
  set +e
  "$@" >"$log" 2>&1
  rc=$?
  set -e
  if [ "$n" -gt 0 ]; then lane_scrub <"$log" | tail -n "$n" | sed 's/^/    /'; fi
  return "$rc"
}

# 온보딩이 슬롯으로 넣은 명령 한 줄을 하위 셸에서 돌린다 — 따옴표·&&·cd 를 그대로 살리고 lane_* 함수도 쓸 수 있으며,
# 명령 안의 cd 가 부르는 스크립트의 자리를 바꾸지 않는다.
lane_eval() ( eval "$1" )

# 메인의 무시 파일(.env 등)을 워크트리에 심볼릭 링크로 건다 — lane_prep 슬롯에서 부른다.
#   lane_link_from_main <저장소 기준 경로>
# ★ gitignore 가 아니면 멈춘다(링크가 커밋될 수 있다). 🚫 내용은 읽지도 찍지도 않는다.
lane_link_from_main() {
  local rel="$1" wt main
  wt="$(git rev-parse --show-toplevel)"; main="$(lane_main_root)"
  [ "$wt" != "$main" ] || { echo "  메인 자체다 — 링크하지 않는다"; return 0; }
  if [ ! -e "$main/$rel" ]; then echo "  ⚠️ 메인에 $rel 이 없다 — 링크를 걸지 않았다"; return 0; fi
  if [ -L "$wt/$rel" ] && [ -e "$wt/$rel" ]; then echo "  $rel 이미 링크 — 그대로 둔다"; return 0; fi
  if [ -e "$wt/$rel" ]; then echo "  ⚠️ 워크트리에 $rel 이 진짜 파일로 있다 — 건드리지 않았다(메인과 갈라질 수 있다)"; return 0; fi
  git -C "$wt" check-ignore -q "$rel" || { echo "  ❌ $rel 이 gitignore 에 안 걸린다 — 링크를 걸면 커밋될 수 있어 멈춘다" >&2; return 4; }
  mkdir -p "$(dirname "$wt/$rel")"
  ln -s "$main/$rel" "$wt/$rel"
  [ -e "$wt/$rel" ] || { echo "  ❌ $rel 링크가 메인 파일을 못 가리킨다" >&2; return 4; }
  echo "  $rel → 메인 링크"
}

# Orca 실행 파일 — ORCA_CLI_COMMAND(있으면 그것) → 리눅스 orca-ide → orca.
# 🚫 리눅스에서 맨 `orca` 는 GNOME 화면 낭독기다 — 그래서 그쪽은 orca-ide 로 간다.
# 찾지 못하면 1 을 돌려준다(죽지 않는다 — 합치기의 「놓아주기」는 실패해도 정리를 이어 가야 한다).
lane_orca_cli() {
  local cli
  if [ -n "${ORCA_CLI_COMMAND:-}" ]; then cli="$ORCA_CLI_COMMAND"
  elif [ "$(uname -s)" = "Linux" ]; then cli="orca-ide"
  else cli="orca"; fi
  command -v "$cli" >/dev/null 2>&1 || { printf '%s' "$cli"; return 1; }
  printf '%s' "$cli"
}

# git 잠금 실패인가 — 「Unable to create '…/index.lock': File exists」 꼴.
# 실측: 합치기가 남은 index.lock 을 「rebase 충돌」로 오판해 멈췄다(충돌은 0건이었다).
lane_is_lock_failure() { grep -qE 'index\.lock|Unable to create' "$1"; }

# 잠금 파일 경로만 뽑는다(있으면). ★ 없어도 0 으로 끝난다 — grep 의 1 이 pipefail 로 새면
# 부르는 쪽(set -e)이 exit 1 로 죽어 잠금 종료코드 8 과 안내를 잃는다(실측).
lane_lock_paths() { { grep -oE "Unable to create '[^']+'" "$1" || true; } | sed -E "s/^Unable to create '//; s/'\$//" | sort -u; }

# 워크트리에 rebase 가 걸려 있나 — 걸려 있을 때만 abort 한다(잠금으로 시작도 못 했으면 abort 할 것이 없다).
lane_rebase_in_progress() {
  local wt="$1" d
  for d in rebase-merge rebase-apply; do
    [ -d "$(git -C "$wt" rev-parse --path-format=absolute --git-path "$d")" ] && return 0
  done
  return 1
}

# 이 폴더(또는 그 아래)를 작업 폴더로 쓰는 프로세스 PID — 줄마다 하나. lsof 가 없으면 /proc(리눅스)로 본다.
#   어느 쪽도 없으면 2 를 돌려준다(확인 못 함).
lane_pids_in_dir() {
  local dir="$1" p d
  if command -v lsof >/dev/null 2>&1; then
    lsof -a -d cwd -Fpn 2>/dev/null | awk -v wt="$dir" '
      /^p/ { pid = substr($0, 2) }
      /^n/ { d = substr($0, 2); if (d == wt || index(d, wt "/") == 1) print pid }' | sort -u
    return 0
  fi
  [ -d /proc/self ] || return 2
  for p in /proc/[0-9]*; do
    d="$(readlink "$p/cwd" 2>/dev/null || true)"
    [ -n "$d" ] || continue
    case "$d" in "$dir"|"$dir"/*) printf '%s\n' "${p#/proc/}" ;; esac
  done
  return 0
}

# ── 레인 기록 ───────────────────────────────────────────────────────────
# 레인 이름 → 워크트리 경로·브랜치·소유자·종류·Orca dispatch 를 **git 공용 디렉터리**에 적는다:
#   <git-common-dir>/lane-state/<이름>      (key=value 줄 · dispatch 는 여러 줄일 수 있다)
# 왜 거기냐 — Orca 가 만든 워크트리는 경로·브랜치를 이름에서 짐작할 수 없다. 그래서 합치기가 이름 규칙이 아니라
#   이 기록으로 찾는다. .git 안이라 어느 워크트리에서도 같은 파일이고, 추적될 일도 gitignore 할 일도 없다.
#   owner=git  : lane-new.sh 가 만든 것(정리 = git worktree remove)
#   owner=orca : Orca 가 만든 것(정리 = orca worktree rm — 사이드바에서도 지운다)
lane_state_dir() {
  local common
  common="$(lane_git_common_dir)" || exit 1
  printf '%s/lane-state' "$common"
}
# ★ 기록 폴더를 못 구하면 실패를 돌려준다 — 예전엔 「/<이름>」 을 0 으로 돌려줘 엉뚱한 경로에 기록할 수 있었다.
lane_state_file() { local d; d="$(lane_state_dir)" || return 1; [ -n "$d" ] || return 1; printf '%s/%s' "$d" "$1"; }

# lane_state_get <기록파일> <키>  → 마지막 값 한 줄(없으면 빈 문자열)
lane_state_get() { [ -f "$1" ] && sed -n "s/^$2=//p" "$1" | tail -n 1 || true; }

# lane_state_all <기록파일> <키>  → 값 전부(줄마다 하나)
lane_state_all() { [ -f "$1" ] && sed -n "s/^$2=//p" "$1" || true; }

# lane_state_put <기록파일> <키> <값>  → 한 줄 덧붙인다(같은 키를 다시 적으면 get 은 마지막 것을 읽는다)
lane_state_put() {
  mkdir -p "$(dirname "$1")"
  case "$3" in *$'\n'*) lane_die "기록 값에 줄바꿈이 있다: $2" ;; esac
  printf '%s=%s\n' "$2" "$3" >>"$1"
}

# 이 워크트리 경로가 적힌 레인 기록의 브랜치(없으면 1). lane-merge 가 「레인인가」를 가를 때 쓴다.
lane_record_branch_for() {
  local want="$1" d f w
  d="$(lane_state_dir)" || return 1
  [ -d "$d" ] || return 1
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    w="$(lane_state_get "$f" worktree)"
    [ -n "$w" ] && [ -d "$w" ] && w="$(cd "$w" && pwd -P)"
    if [ -n "$w" ] && [ "$w" = "$want" ]; then lane_state_get "$f" branch; return 0; fi
  done
  return 1
}

# 열린 구현 레인 수(kind=impl · 기록에 kind 가 없으면 impl 로 본다)
# ★ 워크트리가 기록돼 있는데 그 폴더가 없으면 «죽은 레인»이다 — 세지 않고 알린다(손으로 지운 레인이 자리를 영영 막지 않게).
#   워크트리가 아직 안 적힌 기록은 세운 중인 레인(예약)이라 센다 — 단 예약한 지 1시간이 지났으면 죽은 예약으로 보고 세지 않는다
#   (세우던 스크립트가 강제 종료되면 예약 기록이 남는다).
lane_open_impl_count() {
  local d f k w r now n=0
  now="$(date +%s)"
  d="$(lane_state_dir)" || { echo 0; return 0; }
  [ -d "$d" ] || { echo 0; return 0; }
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    k="$(lane_state_get "$f" kind)"
    [ "${k:-impl}" = impl ] || continue
    w="$(lane_state_get "$f" worktree)"
    if [ -n "$w" ] && [ ! -d "$w" ]; then
      echo "  ⚠️ 죽은 레인 기록(워크트리 없음 — 세지 않는다 · 확인 뒤 지워라): $f" >&2; continue
    fi
    if [ -z "$w" ]; then
      r="$(lane_state_get "$f" reserved_at)"
      if [ -n "$r" ] && [ $((now - r)) -gt 3600 ]; then
        echo "  ⚠️ 1시간 넘은 예약(세우다 멈춘 레인 — 세지 않는다 · 확인 뒤 지워라): $f" >&2; continue
      fi
    fi
    n=$((n + 1))
  done
  echo "$n"
}

# 레인 기록 잠금 — 상한 검사와 예약 쓰기를 한 덩어리로 만든다(두 레인을 동시에 세워도 상한을 넘지 않게). mkdir 은 원자적이다.
# ★ 잡은 동안 Ctrl-C·종료 신호를 받으면 풀고 나간다. 10분 넘은 잠금은 죽은 프로세스가 남긴 것으로 보고 걷는다
#   (잠금 구간은 몇 초짜리라 10분이면 넉넉하다).
lane_lock() {
  local d i=0
  d="$(lane_state_dir)" || exit 1
  mkdir -p "$d"
  if [ -d "$d/.lock" ] && [ -n "$(find "$d/.lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
    echo "  ⚠️ 10분 넘은 잠금을 걷는다(죽은 lane-*.sh 가 남긴 것): $d/.lock" >&2
    rmdir "$d/.lock" 2>/dev/null || true
  fi
  until mkdir "$d/.lock" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -lt 100 ] || lane_die "레인 기록 잠금($d/.lock)을 20초 동안 못 잡았다 — 다른 lane-*.sh 가 도는 중이 아니면 그 폴더를 지우고 다시"
    sleep 0.2
  done
  trap 'lane_unlock; exit 130' INT TERM
}
lane_unlock() { local d; trap - INT TERM; d="$(lane_state_dir)" || return 0; rmdir "$d/.lock" 2>/dev/null || true; }

# 구현 레인 상한 검사 — 넘으면 멈춘다(LANE_FORCE=1 이면 경고만).
lane_check_capacity() {
  local kind="$1" max="${LANE_MAX:-$LANE_MAX_DEFAULT}" open
  [ "$kind" = impl ] || return 0
  open="$(lane_open_impl_count)"
  if [ "$open" -ge "$max" ]; then
    [ "${LANE_FORCE:-0}" = 1 ] && { echo "  ⚠️ 구현 레인 $open/$max — LANE_FORCE=1 이라 계속한다" >&2; return 0; }
    lane_unlock
    lane_die "구현 레인이 이미 $open 개다(상한 $max) — 하나를 합친 뒤 세우거나, 같은 레인에 차례로 넣어라(LANE_FORCE=1 로 넘길 수 있다)"
  fi
}

# 상한 검사 + 예약을 잠금 안에서 — 통과하면 기록 파일에 kind 를 먼저 적어 자리를 잡는다.
#   lane_reserve <기록파일> <종류>   (기록 파일이 이미 있으면 멈춘다)
lane_reserve() {
  local state="$1" kind="$2"
  lane_lock
  if [ -e "$state" ]; then lane_unlock; lane_die "레인 기록이 이미 있다: $state — 그 레인을 먼저 합치거나 정리하라"; fi
  lane_check_capacity "$kind"
  lane_state_put "$state" kind "$kind"
  lane_state_put "$state" reserved_at "$(date +%s)"
  lane_unlock
}
