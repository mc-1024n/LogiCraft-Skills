#!/usr/bin/env bash
# Orca 작업자 레인 하나를 띄운다 (mc-logi-build-onboard 방출 · 시범).
#
#   scripts/lanes/lane-orca.sh [--dry-run] [--kind impl|backfill|other] <이름> <CO-NNN> <제목> <지시 파일>
#
#   --dry-run   Orca 를 부르지 않는다 — 만들 spec 과 부를 명령·기록할 곳만 찍는다
#   --kind      레인 종류(기본 impl · impl 만 동시 상한 {{lane_concurrency}} 을 센다 — 백필 레인은 backfill)
#
# 하는 일:
#   1. spec 을 만든다 = 맨 위 한 줄 안내 + <지시 파일> + 표준 블록(.claude/lanes/lane-prompt-block.md 의
#      「복사 시작~끝」) + 「Orca 복사 시작~끝」 절. 이름·메인 경로·CO 를 채운다.
#      ★ 워크트리 경로는 채우지 않는다 — Orca 가 만들 때 정해지므로 작업자가 첫 단계에서 확인한다(`<워크트리>` 로 남긴다).
#   2. Orca 가 워크트리를 직접 만들게 해서 작업자를 띄운다:
#        ORCA orchestration worker-start --spec-file <spec> --worktree new-child --name lane-<이름>
#             --base-branch <메인 브랜치> --setup skip --agent claude --keep-open --task-title "<제목>" --json
#      왜 직접 안 만드나 — 저장소 안에 git 으로 만든 워크트리는 Orca 사이드바에 안 보였다(실측).
#      ☠️ 그렇다고 워크트리 폴더를 cp 로 복사해 넘기지 마라 — 새 공간은 Orca(new-child) 또는 `git worktree add` 로만.
#      준비(설치·빌드·환경 연결)는 작업자 지시문의 첫 단계 `scripts/lanes/lane-prep.sh` 가 한다.
#   3. 시작 영수증에서 dispatchId · 워크트리 경로를 읽고(없으면 worker-list 에서 찾는다) 브랜치는 그 워크트리에서 읽어
#      레인 기록(<git-common-dir>/lane-state/<이름> · owner=orca)과 <워크트리>/.lane-dispatch 에 적는다.
#      lane-merge.sh 는 이름 규칙이 아니라 이 기록의 경로·브랜치로 합치고, 정리 전에 작업자를 놓아준다.
#
# 필요한 것: Orca CLI · python3(spec 채우기·영수증 읽기 — 이 세트의 노하우 머리말 생성기도 python3 를 쓴다)
# Orca 실행 파일: ORCA_CLI_COMMAND → 리눅스 orca-ide → orca
# 덮어쓰기: LANE_ORCA_AGENT(기본 claude) · LANE_ORCA_MODEL(기본 없음) · LANE_ORCA_TIMEOUT_MS(기본 300000)
# 종료코드: 0 끝 · 1 인자/상태 오류 · 9 작업자 시작 실패 · 10 작업자는 떴을 수 있는데 영수증에서 dispatch·경로를 못 읽음
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lanes/_common.sh
. "$HERE/_common.sh"

usage() { sed -n '3,7p' "$0" >&2; exit 1; }
DRY=0; KIND=impl; ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --kind) [ $# -ge 2 ] || usage; KIND="$2"; shift 2 ;;
    --help|-h) usage ;;
    --*) lane_die "모르는 인자: $1" ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
[ ${#ARGS[@]} -eq 4 ] || usage
NAME="${ARGS[0]}"; CO="${ARGS[1]}"; TITLE="${ARGS[2]}"; INSTR="${ARGS[3]}"
lane_check_name "$NAME"
lane_check_kind "$KIND"
[[ "$CO" =~ ^CO-[0-9]{3,4}$ ]] || lane_die "CO 는 CO-NNN 꼴이어야 한다: '$CO'"
[ -n "${TITLE// /}" ] || lane_die "제목이 비었다"
[ -f "$INSTR" ] || lane_die "지시 파일이 없다: $INSTR"
case "$TITLE" in *"$CO"*) ;; *) TITLE="$CO $TITLE" ;; esac
command -v python3 >/dev/null 2>&1 || lane_die "python3 가 없다 — spec 채우기·영수증 읽기에 쓴다"

MAIN="$(lane_main_root)"
MAINBR="$(lane_main_branch "$MAIN")"
# 블록은 이 스크립트와 함께 바뀌는 짝이다 — 메인 작업 트리가 아니라 스크립트 옆(같은 체크아웃)에서 읽는다.
BLOCK="$(cd "$HERE/../.." && pwd -P)/.claude/lanes/lane-prompt-block.md"
[ -f "$BLOCK" ] || lane_die "표준 블록이 없다: $BLOCK"
STATE="$(lane_state_file "$NAME")" || lane_die "레인 기록 자리를 못 구했다"
[ ! -e "$STATE" ] || lane_die "레인 기록이 이미 있다: $STATE — 그 레인을 먼저 합치거나 정리하라"
! git -C "$MAIN" worktree list --porcelain | grep -qE "^worktree .*/lane-$NAME\$" \
  || lane_die "이름이 lane-$NAME 인 워크트리가 이미 있다 — 다른 이름을 써라"
if [ "$DRY" = 0 ]; then
  # 상한 검사 + 자리 예약을 잠금 안에서. 워크트리를 기록하기 전에 실패하면 예약을 거둔다 —
  #   단 10(작업자는 떴을 수 있다)이면 남긴다(손으로 이어 적는다).
  lane_reserve "$STATE" "$KIND"
  trap 'rc=$?; [ -n "$(lane_state_get "$STATE" worktree)" ] || [ "$rc" = 10 ] || rm -f "$STATE"' EXIT
fi

# CO 파일 이름(메인 브랜치 끝 기준 — 레인은 거기서 갈라진다)
CO_FILES="$(git -C "$MAIN" ls-tree --name-only "$MAINBR" "$LANE_CO_DIR" | grep -E "/$CO-[^/]*\.md\$" || true)"
case "$(printf '%s' "$CO_FILES" | grep -c . || true)" in
  1) CO_BASE="$(basename "$CO_FILES")" ;;
  0) CO_BASE="$CO-*.md"; echo "  ⚠️ $MAINBR 에 $CO 변경지시서가 없다 — 레인이 CO 를 못 읽는다(먼저 메인에 커밋하라)" >&2 ;;
  *) lane_die "$CO 변경지시서가 여럿이다: $(printf '%s' "$CO_FILES" | tr '\n' ' ')" ;;
esac

LOGDIR="$(mktemp -d "${TMPDIR:-/tmp}/lane-orca-$NAME.XXXXXX")"
SPEC="$LOGDIR/spec.md"

# 블록 두 절을 뽑아 채운다(python3 — 경로에 / 가 들어 sed 치환이 위험하다).
LANE_NAME="$NAME" LANE_MAIN="$MAIN" LANE_CO="$CO" LANE_CO_BASE="$CO_BASE" \
python3 - "$BLOCK" "$INSTR" "$SPEC" <<'PY' || lane_die "spec 만들기 실패"
import os, sys
block_path, instr_path, out_path = sys.argv[1:4]
name, main, co, co_base = (os.environ[k] for k in ("LANE_NAME", "LANE_MAIN", "LANE_CO", "LANE_CO_BASE"))
lines = open(block_path, encoding="utf-8").read().split("\n")
def cut(start, end):
    try:
        a = lines.index(start); b = lines.index(end, a)
    except ValueError:
        sys.exit(f"❌ 표준 블록에 '{start}' ~ '{end}' 절이 없다")
    return "\n".join(lines[a + 1:b]).strip()
def fill(t):
    # 자리 줄 — Orca 레인은 경로·브랜치를 이름에서 짐작할 수 없다(Orca 가 정한다).
    t = t.replace("`<메인>/.claude/worktrees/lane-<이름>` (브랜치 `lane/<이름>`)",
                  "`<워크트리>` (Orca 가 만든 이 세션의 폴더 · 브랜치도 Orca 가 붙였다 — 아래 「Orca 작업자」 첫 단계에서 확인)")
    t = t.replace("<워크트리 절대경로>", "<워크트리>")
    t = t.replace("<레인>", name).replace("<메인>", main)
    t = t.replace("CO-NNN-*.md", co_base).replace("CO-NNN", co)
    return t
spec = "\n".join([
    f"> ★ Orca 레인 `{name}` ({co}) — 맨 아래 「Orca 작업자」 절의 **첫 단계**(자리 확인 · `scripts/lanes/lane-prep.sh`)부터 한다.",
    "> 아래 「레인 규칙」·「Orca 작업자」 절은 scripts/lanes/lane-orca.sh 가 .claude/lanes/lane-prompt-block.md 에서 채워 붙였다.",
    "",
    open(instr_path, encoding="utf-8").read().strip(),
    "",
    fill(cut("--- 복사 시작", "--- 복사 끝")),
    "",
    fill(cut("--- Orca 복사 시작", "--- Orca 복사 끝")),
    "",
])
left = [p for p in ("<레인>", "<메인>", "<이름>", "CO-NNN", "<워크트리 절대경로>") if p in spec]
if left:
    sys.exit(f"❌ 안 채운 자리가 남았다: {' '.join(left)}")
open(out_path, "w", encoding="utf-8").write(spec)
PY

CLI="$(lane_orca_cli)" || {
  [ "$DRY" = 1 ] || lane_die "Orca 실행 파일 '$CLI' 를 못 찾는다 — Orca 안에서 부르거나 ORCA_CLI_COMMAND 를 줘라"
  echo "  ⚠️ Orca 실행 파일 '$CLI' 를 못 찾는다(--dry-run 이라 계속한다)" >&2
}
CMD=("$CLI" orchestration worker-start
  --spec-file "$SPEC"
  --worktree new-child --name "lane-$NAME" --base-branch "$MAINBR" --setup skip
  --agent "${LANE_ORCA_AGENT:-claude}" --keep-open
  --task-title "$TITLE"
  --timeout-ms "${LANE_ORCA_TIMEOUT_MS:-300000}"
  --json)
[ -z "${LANE_ORCA_MODEL:-}" ] || CMD+=(--model "$LANE_ORCA_MODEL")

if [ "$DRY" = 1 ]; then
  echo "계획 (--dry-run · Orca 를 부르지 않음)"
  echo "  레인     : $NAME ($CO) · kind=$KIND · 메인 $MAIN ($MAINBR $(git -C "$MAIN" rev-parse --short "$MAINBR"))"
  echo "  CO 파일  : $LANE_CO_DIR$CO_BASE"
  echo "  블록     : $BLOCK"
  # %q 는 macOS bash 에서 한글을 8진수로 깨뜨린다 — 작은따옴표로 감싼다.
  printf '  명령     :'
  for a in "${CMD[@]}"; do
    case "$a" in
      *[!A-Za-z0-9_./:=@,+-]*|'') printf " '%s'" "$(printf '%s' "$a" | sed "s/'/'\\\\''/g")" ;;
      *) printf ' %s' "$a" ;;
    esac
  done
  echo
  echo "  기록     : $STATE  (owner=orca · kind · worktree · branch · co · dispatch — 영수증에서)"
  echo "             <영수증의 워크트리>/.lane-dispatch  (dispatchId 한 줄)"
  echo "  spec     : $SPEC ($(wc -l <"$SPEC" | tr -d ' ')줄)"
  echo "──────── spec ────────"
  cat "$SPEC"
  echo "──────── spec 끝 ────────"
  exit 0
fi

lane_say "작업자 시작 — Orca 가 워크트리 lane-$NAME 을 만든다 ($MAINBR 끝에서 · setup skip)"
BEFORE_LIST="$LOGDIR/workers-before.json"
"$CLI" orchestration worker-list --json >"$BEFORE_LIST" 2>/dev/null || echo '{}' >"$BEFORE_LIST"
if lane_run 0 "$LOGDIR/start.json" "${CMD[@]}"; then START_RC=0; else START_RC=$?; fi
lane_scrub <"$LOGDIR/start.json" | tail -n 12 | sed 's/^/    /'

# 영수증에서 dispatchId · 워크트리 경로를 읽는다. 없으면 worker-list 의 새 항목에서 찾는다.
# ★ 워크트리는 이름이 정확히 lane-<이름> 인 경로만 받는다 — 아무 절대경로나 채택하면 엉뚱한 폴더를 기록에 적는다(실측).
read_receipt() {
  python3 - "$LOGDIR/start.json" "$BEFORE_LIST" "$1" "lane-$NAME" <<'PY'
import json, os, re, sys
start_path, before_path, after_path, want = sys.argv[1:5]
def parse(p):
    try:
        return json.load(open(p, encoding="utf-8"))
    except Exception:
        return None
def walk(o, f, acc):
    if isinstance(o, dict):
        for k, v in o.items():
            f(k, v, acc); walk(v, f, acc)
    elif isinstance(o, list):
        for v in o:
            walk(v, f, acc)
    return acc
def ids(o):
    return walk(o, lambda k, v, a: a.append(v) if re.fullmatch(r"dispatch_?id", k, re.I) and isinstance(v, str) else None, [])
def as_path(v):
    return re.sub(r"^.*::", "", v) if isinstance(v, str) else ""
def paths(o):
    def f(k, v, a):
        if re.fullmatch(r"worktreePath|worktree_path|workspace|worktree|path|cwd", k, re.I):
            p = as_path(v)
            if p.startswith("/") and os.path.exists(p):
                a.append(p)
    return walk(o, f, [])
is_lane = lambda p: os.path.basename(p.rstrip("/")) == want
start = parse(start_path)
did = (ids(start) or [""])[0]
wt = next((p for p in paths(start) if is_lane(p)), "")
after = parse(after_path) if after_path else None
if after:
    workers = walk(after, lambda k, v, a: a.extend(v) if k == "workers" and isinstance(v, list) else None, [])
    if not did:
        seen = set(ids(parse(before_path)))
        did = next((w.get("dispatchId") for w in workers if isinstance(w, dict) and w.get("dispatchId") and w.get("dispatchId") not in seen), "") or ""
    w = next((x for x in workers if isinstance(x, dict) and x.get("dispatchId") == did), None)
    if not wt and w and is_lane(as_path(w.get("workspace"))):
        wt = as_path(w.get("workspace"))
sys.stdout.write(f"{did}|{wt}\n")
PY
}
IFS='|' read -r DISPATCH WT < <(read_receipt "") || true
if [ -z "$DISPATCH" ] || [ -z "$WT" ]; then
  "$CLI" orchestration worker-list --json >"$LOGDIR/workers-after.json" 2>/dev/null || true
  IFS='|' read -r DISPATCH WT < <(read_receipt "$LOGDIR/workers-after.json") || true
fi

if [ "$START_RC" -ne 0 ] && [ -z "$DISPATCH" ]; then
  LANE_DIE_RC=9 lane_die "작업자 시작 실패(exit $START_RC) — 영수증 $LOGDIR/start.json · 워크트리가 남았으면 orca worktree list 로 보라"
fi
if [ -z "$DISPATCH" ] || [ -z "$WT" ] || [ ! -d "$WT" ]; then
  LANE_DIE_RC=10 lane_die "영수증에서 dispatch='${DISPATCH:-?}' 워크트리='${WT:-?}'(이름이 lane-$NAME 인 경로만 받는다) 를 다 못 읽었다 — 작업자는 떴을 수 있다.
   확인: $CLI orchestration worker-list --json · 영수증 $LOGDIR/start.json
   찾았으면 손으로 적는다: $STATE 에 owner=orca · kind=$KIND · worktree=<경로> · branch=<브랜치> · dispatch=<id>"
fi
WT="$(cd "$WT" && pwd -P)"
BR="$(git -C "$WT" branch --show-current)"
[ -n "$BR" ] || lane_die "워크트리 $WT 의 브랜치를 못 읽었다(detached?) — 기록하지 않았다"

lane_state_put "$STATE" owner orca
lane_state_put "$STATE" worktree "$WT"
lane_state_put "$STATE" branch "$BR"
lane_state_put "$STATE" co "$CO"
lane_state_put "$STATE" dispatch "$DISPATCH"
if git -C "$WT" check-ignore -q .lane-dispatch; then
  printf '%s\n' "$DISPATCH" >>"$WT/.lane-dispatch"
else
  echo "  ⚠️ .lane-dispatch 가 그 워크트리에서 gitignore 가 아니다 — 레인을 더럽히지 않으려고 안 적었다(기록 파일에는 있다)" >&2
fi

cat <<EOF

✅ Orca 레인 띄움 — $NAME ($CO) · kind=$KIND
  dispatch  : $DISPATCH $([ "$START_RC" = 0 ] || echo "(⚠️ worker-start exit $START_RC — worker-show 로 상태를 보라)")
  워크트리  : $WT
  브랜치    : $BR (기준 $MAINBR)
  기록      : $STATE
  spec      : $SPEC
  다음      : 작업자가 lane-prep.sh 부터 돈다 · 끝나면 worker_done
              QA 는 scripts/lanes/lane-qa.sh (레인 커밋에 고정 · QA 동안 이 레인에 쓰지 않는다)
              합치기는 scripts/lanes/lane-merge.sh $NAME [--with <그룹>] [--push]
EOF
