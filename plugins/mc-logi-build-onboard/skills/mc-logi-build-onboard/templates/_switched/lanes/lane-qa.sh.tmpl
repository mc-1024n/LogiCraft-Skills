#!/usr/bin/env bash
# 레인 작업의 독립 QA 를 돌리고 판정한다 (mc-logi-build-onboard 방출 · 시범).
#
#   scripts/lanes/lane-qa.sh <라벨> <프롬프트파일>          QA 를 돌리고 판정한다(셸로 부를 수 있는 위임일 때)
#   scripts/lanes/lane-qa.sh --verdict-from <로그파일>      이미 돈 QA 의 로그에서 판정만 한다
#                                                          (서브에이전트 갈래 · 끊긴 판의 로그 회수)
#
# QA 는 구현과 «다른 모델»로 돈다 — 온보딩 확정값(qa_model·qa_invoke·qa_fallback)은 아래 QA_* 변수에 실려 있다.
#
# 하는 일:
#   1. 프롬프트 검사 — 넷 다 있어야 돈다:
#        knowhow_dir_abs: /절대경로   (위임되면 작업 폴더가 달라 상대경로·묶음이 안 따라간다 — 필수)
#        lane_worktree:   /절대경로   (QA 가 볼 레인 워크트리)
#        lane_commit:     <sha>       (★ QA 는 이 커밋에 고정한다 — 이 sha 가 레인 HEAD 와 같아야 시작한다)
#        범위 줄 「전체 시험은 합치기에서 한 번만 돈다」 (★ 없으면 QA 가 전체 시험을 돌린다 — 레인 둘만 겹쳐도 CPU 가 찬다 · 실측)
#   2. **메인 저장소 폴더로 옮겨서** 위임 명령을 부른다 — 워크트리 안에서 부르면 위임 도구가 에이전트 정의를
#      워크트리 사본에서 찾아 이름이 충돌하거나 못 찾는다(실측: 미러 동기화가 exit 2 로 막혔다).
#      레인 경로는 프롬프트에 적는다.
#   3. 출력에서 마지막 `verdict:` 를 읽는다. 없으면 「QA 안 돎」 exit 20.
#   4. 끝난 뒤 레인 HEAD·작업 트리가 lane_commit 그대로인지 본다 — ☠️ QA 동안 레인에 쓰면 판정이 무엇을
#      본 것인지 알 수 없다. 바뀌었으면 verdict 와 무관하게 exit 21.
#
# 종료코드(★ 위임 도구의 종료코드가 아니라 verdict 로 정한다 — pass 를 내고 exit 1 로 끝난 판이 실제로 있었다):
#   0 pass · pass_with_notes   10 fail   11 blocked   12 그 밖의 verdict   20 QA 안 돎(verdict 없음)
#   21 QA 동안 레인이 바뀜   22 이 저장소에 셸 위임 명령이 없다(서브에이전트 갈래 — --verdict-from 을 써라)   1 인자 오류
#   23 pass 인데 인용이 없다 — 출력 read_evidence 에 이번 레인이 바꾼 파일이 하나도 없거나 저장소에 없는 경로가 있다
#      (다른 모델이 남의 프로젝트 내용을 지어내 pass 를 낸 실측이 있다 → 「안 돎」으로 보고 대체 경로로)
#
# 덮어쓰기: LANE_QA_SHELL(위임 명령 한 줄 · 자리 {label} {prompt} {main})
#   자리는 맨으로(`{main}`) 쓰거나 자리만 따옴표로 감싼다(`"{main}"`). 🚫 다른 글자와 붙여 따옴표 안에 넣지 마라(`"x{main}y"`) — 경로의 공백에서 갈라진다.
# 🚫 출력에서 자격증명이 실린 URL 줄은 거른다.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lanes/_common.sh
. "$HERE/_common.sh"

# 온보딩 확정값 — 따옴표 heredoc 이라 값에 따옴표·$ 가 있어도 그대로 실린다(여러 줄도 된다).
QA_MODEL="$(cat <<'QA_EOF'
{{qa_model}}
QA_EOF
)"
QA_INVOKE="$(cat <<'QA_EOF'
{{qa_invoke}}
QA_EOF
)"
QA_FALLBACK="$(cat <<'QA_EOF'
{{qa_fallback}}
QA_EOF
)"

# 위임 명령 — 온보딩이 qa_invoke 를 셸 한 줄로 옮긴 것(자리: {label} {prompt} {main}). 비면 서브에이전트 갈래다.
<!-- IF lane_qa_shell -->
QA_SHELL_DEFAULT="$(cat <<'QA_SHELL_EOF'
{{lane_qa_shell}}
QA_SHELL_EOF
)"
<!-- ELSE -->
QA_SHELL_DEFAULT=""   # QA 갈래가 서브에이전트라 셸로 부를 명령이 없다 — 오케스트레이터가 띄우고 --verdict-from 으로 판정
<!-- ENDIF lane_qa_shell -->
QA_SHELL="${LANE_QA_SHELL:-$QA_SHELL_DEFAULT}"
# 노하우 묶음 폴더(저장소 기준) — 절대경로는 실행할 때 메인 꼭대기에서 계산한다(팀원마다 저장소 자리가 달라 박아 두지 않는다).
KH_REL='{{knowhow_dir}}'
# QA 프롬프트에 그대로 있어야 하는 범위 줄(바꾸면 dispatch 「병행 레인」 절의 문장도 함께 바꾼다).
QA_SCOPE_LINE='전체 시험은 합치기에서 한 번만 돈다'

# 로그에서 마지막 verdict 를 뽑는다 — `verdict : pass`(요약) · `verdict: pass`(에이전트 원문) 둘 다 받는다.
# ☠️ 판정값 넷만 받는다 — 위임 래퍼의 요약 줄 `verdict : ok`(래퍼 자체 상태)가 맨 뒤에 붙어 진짜 판정을 덮었다(2026-11-18 CO-425 실측 · rc=12).
verdict_of() { { grep -oE 'verdict[[:space:]]*:[[:space:]]*(pass_with_notes|pass|fail|blocked)\b' "$1" || true; } | tail -1 | sed -E 's/.*:[[:space:]]*//'; }
exit_for() {
  case "$1" in
    pass|pass_with_notes) return 0 ;;
    fail) return 10 ;;
    blocked) return 11 ;;
    *) return 12 ;;
  esac
}

if [ "${1:-}" = --verdict-from ]; then
  [ $# -eq 2 ] && [ -f "$2" ] || lane_die "사용법: $0 --verdict-from <로그파일>"
  V="$(verdict_of "$2")"
  [ -n "$V" ] || { echo "❌ QA 안 돎 — 로그에 verdict 줄이 없다. 판정 없이 넘어가지 마라(대체: $QA_FALLBACK)" >&2; exit 20; }
  echo "verdict: $V  (로그 $2) — 인용 확인(read_evidence 가 바뀐 파일을 실제로 인용하나)은 메인이 dispatch Phase 5.5 대로 한다"
  set +e; exit_for "$V"; rc=$?; set -e; exit "$rc"
fi

[ $# -eq 2 ] || { echo "사용법: $0 <라벨> <프롬프트파일> | $0 --verdict-from <로그파일>" >&2; exit 1; }
LABEL="$1"; PROMPT="$2"
[[ "$LABEL" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]] || lane_die "라벨은 영숫자·. _ - 1~80자: '$LABEL'"
[ -f "$PROMPT" ] || lane_die "프롬프트 파일이 없다: $PROMPT"
PROMPT_ABS="$(cd "$(dirname "$PROMPT")" && pwd -P)/$(basename "$PROMPT")"

# 프롬프트의 `키: 값` 한 줄을 읽는다(따옴표 벗김)
prompt_val() {
  local line
  line="$(grep -E "^[[:space:]]*$1:" "$PROMPT_ABS" | head -1 || true)"
  sed -E "s/^[[:space:]]*$1:[[:space:]]*//; s/[[:space:]]*\$//; s/^[\"']//; s/[\"']\$//" <<<"$line"
}

grep -qF "$QA_SCOPE_LINE" "$PROMPT_ABS" \
  || lane_die "프롬프트에 범위 줄 「$QA_SCOPE_LINE — 여기서는 바꾼 파일·직접 사용처·변이만」이 없다(QA 가 전체 시험을 돌린다)"
KH_DIR="$(prompt_val knowhow_dir_abs)"
[ -n "$KH_DIR" ] || lane_die "프롬프트에 knowhow_dir_abs 가 없다 — 노하우 묶음 절대경로를 넣어라(이 저장소: $(lane_main_root)/${KH_REL%/})"
[[ "$KH_DIR" == /* ]] || lane_die "knowhow_dir_abs 는 절대경로여야 한다(받은 값: '$KH_DIR') — 위임되면 작업 폴더가 달라 상대경로를 못 찾는다"
[ -d "$KH_DIR" ] || lane_die "knowhow_dir_abs 폴더가 없다: $KH_DIR"

LWT="$(prompt_val lane_worktree)"
LCOMMIT="$(prompt_val lane_commit)"
[ -n "$LWT" ] && [[ "$LWT" == /* ]] && [ -d "$LWT" ] || lane_die "프롬프트에 lane_worktree: <절대경로> 가 없거나 폴더가 없다"
[ -n "$LCOMMIT" ] || lane_die "프롬프트에 lane_commit: <sha> 가 없다 — QA 는 레인 커밋 하나에 고정한다"
HEAD_NOW="$(git -C "$LWT" rev-parse HEAD)"
LFULL="$(git -C "$LWT" rev-parse --verify --quiet "$LCOMMIT^{commit}" || true)"
[ -n "$LFULL" ] || lane_die "lane_commit '$LCOMMIT' 을 레인에서 못 찾는다"
[ "$LFULL" = "$HEAD_NOW" ] || lane_die "레인 HEAD($(git -C "$LWT" rev-parse --short HEAD))가 lane_commit 과 다르다 — 커밋을 다시 적어라"
[ -z "$(git -C "$LWT" status --porcelain)" ] || lane_die "레인에 커밋 안 된 것이 있다 — QA 는 커밋된 것만 본다(먼저 커밋)"

if [ -z "$QA_SHELL" ]; then
  echo "ℹ️ 이 저장소의 QA 는 서브에이전트 갈래다($QA_MODEL) — 셸로 부를 명령이 없다." >&2
  echo "   오케스트레이터가 이 프롬프트로 띄우고($QA_INVOKE) 출력을 파일로 남긴 뒤: $0 --verdict-from <로그>" >&2
  exit 22
fi

MAIN="$(lane_main_root)"
HERE_TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$HERE_TOP" ] && [ "$(cd "$HERE_TOP" && pwd -P)" != "$MAIN" ]; then
  echo "  ↪ 워크트리($HERE_TOP)에서 불렸다 — 메인($MAIN)으로 옮겨서 돌린다"
fi

# 자리 {label} {prompt} {main} 은 값을 글자로 박지 않고 «변수 참조»로 바꾼다 — eval 이 그 변수를 펼친다.
# ★ 왜: printf %q 는 bash 3.2 에서 한글 경로를 $'\354…' 로 만들어, 실행줄이 자리를 "{main}" 처럼 따옴표로 감싸면
#   그 안에서 펼쳐지지 않아 경로가 깨졌다(실측). 변수 참조는 따옴표 안팎 어디서나 맞게 펼쳐진다.
#   "{x}" · '{x}' · 맨 {x} 셋 다 "$변수" 하나로 바꾼다(공백 든 경로도 한 인자로 간다).
LANE_QA_LABEL="$LABEL"; LANE_QA_PROMPT="$PROMPT_ABS"; LANE_QA_MAIN="$MAIN"
# bash 5.2 의 patsub_replacement 는 치환 값의 & 를 「찾은 글자」로 바꾼다 — 끈다(옛 bash 엔 없는 옵션이라 실패를 삼킨다).
shopt -u patsub_replacement 2>/dev/null || true
CMD="$QA_SHELL"
for k in label prompt main; do
  case "$k" in label) v='"$LANE_QA_LABEL"' ;; prompt) v='"$LANE_QA_PROMPT"' ;; main) v='"$LANE_QA_MAIN"' ;; esac
  CMD="${CMD//\"\{$k\}\"/$v}"
  CMD="${CMD//\'\{$k\}\'/$v}"
  CMD="${CMD//\{$k\}/$v}"
done

OUT="$(mktemp "${TMPDIR:-/tmp}/lane-qa-$LABEL.XXXXXX")"
lane_say "QA $QA_MODEL · 라벨 $LABEL · 레인 커밋 $(git -C "$LWT" rev-parse --short HEAD) · 원문 로그 $OUT(거르기 전 · 공유 금지)"
set +e
(cd "$MAIN" && eval "$CMD") 2>&1 | tee "$OUT" | lane_scrub
RC="${PIPESTATUS[0]}"
set -e

VERDICT="$(verdict_of "$OUT")"
MOVED=""
[ "$(git -C "$LWT" rev-parse HEAD)" = "$HEAD_NOW" ] || MOVED="HEAD 가 움직였다"
[ -z "$(git -C "$LWT" status --porcelain)" ] || MOVED="${MOVED:+$MOVED · }커밋 안 된 변경이 생겼다"

if [ -z "$VERDICT" ]; then
  echo "❌ QA 안 돎 — verdict 가 없다(위임 exit=$RC · 로그 $OUT). 판정 없이 넘어가지 마라 — 대체: $QA_FALLBACK" >&2
  echo "   (완주했는데 verdict 직전에 끊겼을 수 있다 — 재실행 전에 로그에서 판정을 회수하라)" >&2
  exit 20
fi
# 인용 확인 — pass 일 때만. 마지막 read_evidence 블록의 file: 값들을 뽑는다.
if [ -z "$MOVED" ] && { [ "$VERDICT" = pass ] || [ "$VERDICT" = pass_with_notes ]; }; then
  BASE="$(git -C "$LWT" merge-base HEAD "$(lane_main_branch "$MAIN")" 2>/dev/null || true)"
  CHANGED="$([ -z "$BASE" ] || git -C "$LWT" -c core.quotepath=off diff --name-only "$BASE" HEAD)"   # quotepath=off — 한글 경로가 8진수로 바뀌면 대조가 틀린다
  CITED="$(awk '/read_evidence:/ { n = 0; on = 1; next }
                on && /^[^[:space:]-]/ { on = 0 }
                on { line[++n] = $0 }
                END { for (i = 1; i <= n; i++) print line[i] }' "$OUT" \
           | grep -oE 'file:[[:space:]]*[^,}]+' | sed -E "s/^file:[[:space:]]*//; s/[\"']//g; s/[[:space:]]+\$//" || true)"
  HIT=0; BAD=""
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    if [ ! -e "$LWT/$c" ]; then BAD="${BAD:+$BAD · }$c"; continue; fi
    printf '%s\n' "$CHANGED" | grep -qxF "$c" && HIT=$((HIT + 1))
  done <<<"$CITED"
  if [ "$HIT" -eq 0 ] || [ -n "$BAD" ]; then
    echo "❌ verdict 는 '$VERDICT' 인데 인용이 성립하지 않는다 — 바뀐 파일 인용 ${HIT}건${BAD:+ · 저장소에 없는 경로: $BAD}. 안 돈 것으로 보고 대체: $QA_FALLBACK (원문 로그 $OUT)" >&2
    exit 23
  fi
fi
if [ -n "$MOVED" ]; then
  echo "❌ QA 동안 레인이 바뀌었다($MOVED) — verdict '$VERDICT' 는 무엇을 본 것인지 알 수 없다. 레인 쓰기를 멈추고 다시 돌려라" >&2
  exit 21
fi
echo "verdict: $VERDICT  (위임 exit=$RC — 판정은 verdict 로 한다 · 원문 로그 $OUT — 거르기 전 원문이라 공유하지 마라)"
set +e; exit_for "$VERDICT"; rc=$?; set -e; exit "$rc"
